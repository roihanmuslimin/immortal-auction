  "globalAllowedFiles": [
    "package.json",
    "README.md",
    ".gitignore",
    ".github/workflows/ci.yml",
    ".github/workflows/import.yml"
  ],
  "protectedFiles": [
    ".github/workflows/import.yml",
    "tasks/state.json"
  ],
  "protectedPrefixes": [
