{
  "maxArchiveBytes": 20971520,
  "maxExpandedBytes": 52428800,
  "maxFiles": 2000,
  "maxFileBytes": 5242880,
  "maxCompressionRatio": 100,
  "allowedExtensions": [
    ".js",
    ".mjs",
    ".json",
    ".md",
    ".yml",
    ".txt",
    ".html",
    ".css"
  ],
  "globalAllowedPrefixes": [
    "src/",
    "tests/",
    "tools/",
    "docs/"
